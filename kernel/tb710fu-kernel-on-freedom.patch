+/*
+ * DSC, straight out of the vendor node's qcom,mdss-dsc-* properties:
+ * bit-per-pixel 8, bit-per-component 10, one encoder, slice 800x20, two slices
+ * per packet, DSC 1.2, block prediction on.  800 is half of one link's 1600
+ * columns, so with the full 3200-wide mode the slice maths give two slices per
+ * link per line and two packets per line - exactly the vendor's numbers.
+ */
+static const struct drm_dsc_config tb710fu_nt36532_dsc_cfg = {
+	.dsc_version_major = 1,
+	.dsc_version_minor = 2,
+	.slice_height = 20,
+	.slice_width = 800,
+	.slice_count = 2,
+	.bits_per_component = 10,
+	.bits_per_pixel = 8 << 4,
+	.block_pred_enable = true,
+};
