+int aw882xx_hw_reset(struct aw882xx *aw882xx)
+{
+	aw_dev_info(aw882xx->dev, "enter");
+
+	if (aw882xx->reset_gpio) {
+		gpiod_set_value_cansleep(aw882xx->reset_gpio, 0);
+		mdelay(1);
+		gpiod_set_value_cansleep(aw882xx->reset_gpio, 1);
+		mdelay(2);
+	} else {
