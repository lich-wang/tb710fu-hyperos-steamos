+{
+	int ret = 0;
+	uint32_t msg_id = -EINVAL;
+	int32_t read_re = 0;
+
+	if (aw_dev->channel == AW_DEV_CH_PRI_L ||
+			aw_dev->channel == AW_DEV_CH_SEC_L ||
