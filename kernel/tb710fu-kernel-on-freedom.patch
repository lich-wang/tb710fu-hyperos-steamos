+static const struct proc_ops nvt_selftest_fops = {
+	.proc_open = nvt_selftest_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = seq_release,
+};
+#else
+static const struct file_operations nvt_selftest_fops = {
+	.owner = THIS_MODULE,
+	.open = nvt_selftest_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = seq_release,
+};
