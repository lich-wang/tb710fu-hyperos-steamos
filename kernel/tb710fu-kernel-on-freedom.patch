+/*
+ * TB710FU: the DPU-side capture (DSC encoder blocks + INTF0/INTF1) that used
+ * to live here is gone for good.  Reading 0xae81000 (dpu-dsc) while the
+ * pipeline streams delivers an asynchronous SError and a silent hard reset
+ * ~30s later - with no panic, no oops and nothing in pstore, which is exactly
+ * the 495s reset this board kept hitting (the round-40/45 dumps landed at
+ * ~410s/~460s).  It was bring-up instrumentation; the ABL-vs-ours diff it was
+ * chasing has long been captured.
+ */
+
+static ssize_t dsi_host_transfer(struct mipi_dsi_host *host,
+				 const struct mipi_dsi_msg *msg);
+
+/*
+ * TB710FU: the two "poke the panel while it is streaming" helpers that used to
+ * live here - a DCS GET_POWER_MODE read and a bare EXIT_SLEEP_MODE +
+ * SET_DISPLAY_ON pair - are gone.  tb710fu_ctrl_fixup() keeps CMD_MODE_EN set
+ * alongside VIDEO_MODE_EN, i.e. the host runs in interleaved mode, and issuing
+ * a command into a live interleaved stream sets
+ * DSI_STATUS0_INTERLEAVE_OP_CONTENTION, which mainline treats as a real error
+ * (DSI_ERR_STATE_INTERLEAVE_OP_CONTENTION).  Seen on v92: the link was clean
+ * (st0=0x8, matching the ABL snapshot) until the round-5 read at t=69s, after
+ * which st0 became 0x2008, the frame counter restarted and the panel showed a
+ * band of link noise.  Those pokes were diagnostics for the "no card0" era;
+ * with the panel actually streaming they only corrupt the picture.
+ */
+
+static void dsi_diag_worker(struct work_struct *work)
+{
+	struct msm_dsi_host *msm_host = container_of(to_delayed_work(work),
+					struct msm_dsi_host, diag_work);
+	unsigned int frames = msm_host->diag_frames;
+	unsigned int round = msm_host->diag_rounds++;
+	const char *name = dev_name(&msm_host->pdev->dev);
+
+	msm_host->diag_frames = 0;
+	/*
+	 * dsi_wait4video_done() masks VIDEO_DONE again, and dsi_error() masks
+	 * ERROR after the first fault - which silently hides every later one.
+	 * Re-arm both so the heartbeat stays honest about ongoing errors.
+	 */
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_VIDEO_DONE, 1);
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 1);
+
+	/* keep the vendor register state intact against later reverts */
+	tb710fu_ctrl_fixup(msm_host);
+
+	/*
+	 * TB710FU: everything below is bring-up instrumentation that reads the
+	 * live link and printed at KERN_ERR every 10s per link.  It is opt-in
+	 * now that the panel streams (see tb_dsi_diag); the vendor-state fixup
+	 * above still runs every round either way.
+	 */
+	if (!tb_dsi_diag)
+		goto requeue;
+
+	/* v46's TPG auto-arm removed for v47: sync-dual-dsi round streams
+	 * real DSC video again.  The tpg= readback stays as a heartbeat
+	 * sanity field. */
+
+	/* Two lines: the combined one ran past the length the console logger
+	 * keeps, so the interesting tail (ack/irq) was getting cut off. */
+	pr_err("TBDSI-HB %s frames=%u ctrl=%#x st0=%#x fifo=%#x lane=%#x phy=%#x tpg=%#x\n",
+	       name, frames,
+	       dsi_read(msm_host, REG_DSI_CTRL),
+	       dsi_read(msm_host, REG_DSI_STATUS0),
+	       dsi_read(msm_host, REG_DSI_FIFO_STATUS),
+	       dsi_read(msm_host, REG_DSI_LANE_STATUS),
+	       dsi_read(msm_host, REG_DSI_DLN0_PHY_ERR),
+	       dsi_read(msm_host, REG_DSI_TEST_PATTERN_GEN_CTRL));
+	pr_err("TBDSI-HB %s vid=%#x acth=%#x tot=%#x clk=%#x to=%#x ack=%#x irq=%#x lctrl=%#x cctrl=%#x\n",
+	       name,
+	       dsi_read(msm_host, REG_DSI_VID_CFG0),
+	       dsi_read(msm_host, REG_DSI_ACTIVE_H),
+	       dsi_read(msm_host, REG_DSI_TOTAL),
+	       dsi_read(msm_host, REG_DSI_CLK_STATUS),
+	       dsi_read(msm_host, REG_DSI_TIMEOUT_STATUS),
+	       dsi_read(msm_host, REG_DSI_ACK_ERR_STATUS),
+	       dsi_read(msm_host, REG_DSI_INTR_CTRL),
+	       dsi_read(msm_host, REG_DSI_LANE_CTRL),
+	       dsi_read(msm_host, REG_DSI_CLK_CTRL));
+
+	/* one-shot: the rates the link clocks actually ended up running at.
+	 * esc in particular is never set explicitly on 6g hosts - it relies on
+	 * DT assigned-clocks, and our byte-patched vendor DTB may not carry
+	 * them, which would break every LP command's timing. */
+	if (round == 1)
+		pr_err("TBDSI-CLK %s byte=%lu esc=%lu pixel=%lu bintf=%lu\n",
+		       name,
+		       clk_get_rate(msm_host->byte_clk),
+		       clk_get_rate(msm_host->esc_clk),
+		       clk_get_rate(msm_host->pixel_clk),
+		       msm_host->byte_intf_clk ?
