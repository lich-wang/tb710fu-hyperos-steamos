+static const struct drm_display_mode tb710fu_nt36532_modes[] = {
+	{
+		/* 3200x2000 at 120 Hz - the *panel's* size, not one link's.
+		 *
+		 * The vendor tree describes this panel as 1600 wide per DSI link
+		 * (qcom,mdss-dsi-panel-width = <1600>) with two links, so the two
+		 * links split one 3200x2000 image.  Mainline's dual-DSI support
+		 * does that split itself, halving the horizontal timings for each
+		 * host.  Reporting 1600 here therefore made each host drive 800
+		 * pixel columns, and the resulting timing mismatch showed up as a
+		 * continuous stream of "dsi_err_worker: status=5".
+		 *
+		 * Every horizontal number is the vendor's per-link value times two:
+		 * the vendor's porches are per link (138/8/16), so the full-width
+		 * mode needs 276/16/32.
+		 *
+		 * The refresh rate is 120 Hz because that is the only rate at which
+		 * the vendor ever clocks the link.  Its
+		 * qcom,mdss-dsi-panel-clockrate of 0x47686D10 is 1198 Mbps per
+		 * lane, which is exactly what mainline's dsi_byte_clk_get_rate()
+		 * derives from this mode (955,708,000 -> 1178/3524 -> /2 ->
+		 * *30/32 -> *8), while a 60 Hz mode would derive half of it.  The
+		 * vendor's dynamic-fps support changes refresh by stretching the
+		 * vertical front porch only, so the panel has never seen another
+		 * link rate.
+		 */
+		.clock = (3200 + 276 + 16 + 32) * (2000 + 26 + 2 + 232) * 120 / 1000,
+		.hdisplay = 3200,
+		.hsync_start = 3200 + 276,
+		.hsync_end = 3200 + 276 + 16,
+		.htotal = 3200 + 276 + 16 + 32,
+		.vdisplay = 2000,
+		.vsync_start = 2000 + 26,
+		.vsync_end = 2000 + 26 + 2,
+		.vtotal = 2000 + 26 + 2 + 232,
+	},
+};
