+			NVT_ERR("Couldn't get POWER_SUPPLY_PROP_ONLINE rc=%d\n", ret);
+		} else {
+			ts->usb_plug_status = prop.intval;
+			NVT_LOG("boot check usb_plug_status = %d\n", prop.intval);
+		}
+	}
