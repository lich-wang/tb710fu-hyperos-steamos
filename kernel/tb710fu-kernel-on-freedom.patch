+	touchscreen@0 {
+		compatible = "novatek,NVT-ts-spi";
+		reg = <0>;
+
+		spi-max-frequency = <9600000>;
+		/*
+		 * Vendor NT36XXX_SPI driver parses this itself and only wants the
+		 * raw gpio number out of cell 1 ("novatek,irq-gpio"), it does not
+		 * use the standard irq-gpios binding.
+		 */
+		/*
+		 * RESX goes through the descriptor API now - the driver calls
+		 * fwnode_gpiod_get_index(np, "novatek-reset", ..) which resolves
+		 * this "<con_id>-gpios" property - because the legacy
+		 * gpio_request_one() path returns -EPROBE_DEFER for this line on
+		 * this kernel whatever global number is used.  With
