diff --git a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu-kshim.dts b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu-kshim.dts
new file mode 100644
index 0000000..470b8e3
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu-kshim.dts
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * TB710FU booted from the kShimC menu (boot_a), diagnostic profile.
+ * Base board = tb710fu-linux sm8650-lenovo-tb710fu.dts.
+ * - Console on the ABL splash scanout via simple-framebuffer: kShimC fills
+ *   this disabled template with the measured scanout and enables it.
+ * - MDSS/DSI/GPU nodes on, drivers modular + blacklisted (see step 5 note);
+ *   video (iris) off; WiFi on PCIe0, ath12k loaded on demand.
+ */
+#include "sm8650-lenovo-tb710fu.dts"
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	chosen {
+		bootargs = "console=tty0 loglevel=7 clk_ignore_unused pd_ignore_unused regulator_ignore_unused rdinit=/init tb710fu.nbd nbd.max_part=8";
+		/delete-property/ stdout-path;
+
+		framebuffer0: framebuffer@d5100000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xd5100000 0x0 (3200 * 2000 * 4)>;
+			width = <3200>;
+			height = <2000>;
+			stride = <(3200 * 4)>;
+			format = "a8r8g8b8";
+			status = "disabled";
+		};
+	};
+};
+
+/* Step 5 (10/19): MDSS/DSI/GPU nodes enabled (base dts = tbl's working panel
+ * description). Their drivers are modules (msm, panel-nt36532-wqhd-dual-dsi-dsc,
+ * sy7758, aw37503, dispcc_sm8550, gpucc_sm8650) and stay blacklisted on the rootfs
+ * until the native panel is proven: an enabled-but-unprobed node leaves ABL's
+ * scanout alone (same as dispcc), so simpledrm keeps working. */
+&iris { status = "disabled"; };
+
+/* USB: dual role via pmic-glink UCSI (needs the ADSP, now running):
+ * device role towards a PC (NCM console), host role on an OTG adapter/hub. */
+
+/* Your own unit's BT address (HyperOS: getprop ro.odm.lenovo.btaddr), little-endian;
+ * all zeros = unset. The base dts carries another unit's address. */
+&uart14 {
+	bluetooth {
+		local-bd-address = [00 00 00 00 00 00];
+	};
+};
+/* ADSP/CDSP firmware = this device's own split images from HyperOS
+ * /vendor/firmware_mnt/image (installed under qcom/sm8650/xiaoxin/gt/). */
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8650/xiaoxin/gt/adsp.mdt",
+			"qcom/sm8650/xiaoxin/gt/adsp_dtb.mdt";
+};
+&remoteproc_cdsp {
+	firmware-name = "qcom/sm8650/xiaoxin/gt/cdsp.mdt",
+			"qcom/sm8650/xiaoxin/gt/cdsp_dtb.mdt";
+};
+
+/* aw37504 bias + sy7758 backlights: enabled for the native panel; their drivers
+ * (aw37503, sy7758) are modules and blacklisted until the panel test -- a probed
+ * aw37503 with no consumer drives ENP/ENN low -> black. */
+
+/* dispcc: keep the node ENABLED but never load its driver (rootfs blacklists
+ * dispcc_sm8550). Probing reconfigures the display PLLs (scanout dies); a
+ * disabled node lets rpmhpd sync_state drop the MMCX vote (scanout dies too).
+ * An enabled-but-unprobed consumer keeps sync_state pending -> votes kept. */
+
+/* Speakers: 4x Awinic AW882xx smart PA on i2c_hub_4, fed by TDM1 (SECONDARY_TDM_RX_0,
+ * 4 slots x 32 bit). Taken from tb710fu-linux's running DTB (dtb-20261006). */
+&tlmm {
+	tdm1_clk_active: tdm1-clk-active-state {
+		pins = "gpio121"; function = "i2s1_sck"; drive-strength = <8>; bias-disable; output-high;
+	};
+	tdm1_clk_sleep: tdm1-clk-sleep-state {
+		pins = "gpio121"; function = "gpio"; drive-strength = <2>; bias-pull-down; input-enable;
+	};
+	tdm1_ws_active: tdm1-ws-active-state {
+		pins = "gpio123"; function = "i2s1_ws"; drive-strength = <8>; bias-disable; output-high;
+	};
+	tdm1_ws_sleep: tdm1-ws-sleep-state {
+		pins = "gpio123"; function = "gpio"; drive-strength = <2>; bias-pull-down; input-enable;
+	};
+	tdm1_din_active: tdm1-din-active-state {
+		pins = "gpio122"; function = "i2s1_data0"; drive-strength = <8>; bias-disable;
+	};
+	tdm1_din_sleep: tdm1-din-sleep-state {
+		pins = "gpio122"; function = "gpio"; drive-strength = <2>; bias-pull-down; input-enable;
+	};
+	tdm1_dout_active: tdm1-dout-active-state {
+		pins = "gpio124"; function = "i2s1_data1"; drive-strength = <8>; bias-disable;
+	};
+	tdm1_dout_sleep: tdm1-dout-sleep-state {
+		pins = "gpio124"; function = "gpio"; drive-strength = <2>; bias-pull-down; input-enable;
+	};
+};
+
+&i2c_master_hub_0 {
+	status = "okay";
+};
+
+&i2c_hub_4 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	spk_amp0: aw882xx@34 {
+		compatible = "awinic,aw882xx_smartpa"; reg = <0x34>; #sound-dai-cells = <0>;
+		rename-flag = <1>; monitor-mode = "hal_monitor"; aw-cali-mode = "none";
+		aw-re-max = <30000>; aw-re-min = <4000>; sync-load = <1>; sound-channel = <0>;
+		reset-gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
+	};
+	spk_amp1: aw882xx@35 {
+		compatible = "awinic,aw882xx_smartpa"; reg = <0x35>; #sound-dai-cells = <0>;
+		rename-flag = <1>; monitor-mode = "hal_monitor"; aw-cali-mode = "none";
+		aw-re-max = <30000>; aw-re-min = <4000>; sync-load = <1>; sound-channel = <1>;
+		reset-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+	};
+	spk_amp2: aw882xx@36 {
+		compatible = "awinic,aw882xx_smartpa"; reg = <0x36>; #sound-dai-cells = <0>;
+		rename-flag = <1>; monitor-mode = "hal_monitor"; aw-cali-mode = "none";
+		aw-re-max = <30000>; aw-re-min = <4000>; sync-load = <1>; sound-channel = <2>;
+		reset-gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
+	};
+	spk_amp3: aw882xx@37 {
+		compatible = "awinic,aw882xx_smartpa"; reg = <0x37>; #sound-dai-cells = <0>;
+		rename-flag = <1>; monitor-mode = "hal_monitor"; aw-cali-mode = "none";
+		aw-re-max = <30000>; aw-re-min = <4000>; sync-load = <1>; sound-channel = <3>;
+		reset-gpios = <&tlmm 60 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/ {
+	sound {
+		compatible = "qcom,sm8650-sndcard", "qcom,sm8450-sndcard";
+		model = "Lenovo-TB710FU";
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&tdm1_clk_active &tdm1_ws_active &tdm1_din_active &tdm1_dout_active>;
+		pinctrl-1 = <&tdm1_clk_sleep &tdm1_ws_sleep &tdm1_din_sleep &tdm1_dout_sleep>;
+
+		aw-spk-dai-link {
+			link-name = "AW882xx Playback";
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <0xf>;
+			};
+			codec {
+				sound-dai = <&spk_amp0>, <&spk_amp1>, <&spk_amp2>, <&spk_amp3>;
+			};
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+};
+
+/* GPU top level as on HyperOS (kgsl max_clock 903 MHz; vendor DTB pwrlevel 0:
+ * 903 MHz @ RPMh level 384 = TURBO, bus index 9 = highest, same ACD value as 834). */
+&gpu_opp_table {
+	opp-903000000 {
+		opp-hz = /bits/ 64 <903000000>;
+		opp-level = <RPMH_REGULATOR_LEVEL_TURBO>;
+		opp-peak-kBps = <14398437>;
+		qcom,opp-acd-level = <0x882a5ffd>;
+	};
+};
+
+/*
+ * Active pen (Lenovo Tab Pen Plus) through the NT36532 touch IC, as in the
+ * HyperOS dtbo (novatek,pen-support): registers "NVTCapacitivePen"
+ * (pressure 0-4095, tilt, BTN_STYLUS/BTN_STYLUS2) and reads the 14-byte pen
+ * packet after the finger data.
+ */
+&spi4 {
+	touchscreen@0 {
+		novatek,pen-support;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
new file mode 100644
index 0000000..af70725
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
@@ -0,0 +1,1248 @@
+/dts-v1/;
+
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/leds/common.h>
+#include "sm8650.dtsi"
+#include "pm8550.dtsi"
+#include "pm8550b.dtsi"
+#define PMK8550VE_SID 8
+#include "pm8550ve.dtsi"
+#include "pm8550vs.dtsi"
+#include "pmk8550.dtsi"
+
+/delete-node/ &aop_tme_uefi_merged_mem;
+
+/* TB710FU: drop the PDC wakeup hierarchy from the TLMM.  GPIO 162 (touch
+ * INT) sits in sm8650_pdc_map, so with wakeup-parent set the pinctrl
+ * driver marks it skip_wake_irqs and never programs the tlmm INTR registers
+ * (verified by register dump: en=0/raw=0/det=0/tgt=7); delivery then relies
+ * entirely on the PDC, which does not forward anything on this board (INT
+ * pulses confirmed on the pad, irq count stuck at 0).  Falling back to the
+ * classic tlmm summary path (GIC SPI 208) programs the registers and
+ * delivers; nothing in this port uses system suspend, so the PDC wakeup
+ * capability is not missed. */
+&tlmm { /delete-property/ wakeup-parent; };
+
+/ {
+	model = "Lenovo Xiaoxin Pad Pro GT (TB710FU)";
+	compatible = "lenovo,tb710fu", "qcom,sm8650";
+	chassis-type = "tablet";
+
+	qcom,msm-id = <696 0x20000>;
+	region_country = "PRC";
+	qcom,board-id = <0x08 0x00>;
+
+	aliases {
+		serial0 = &uart15;
+		serial1 = &uart14;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+	};
+	
+	pmic-glink {
+		compatible = "qcom,sm8650-pmic-glink",
+			     "qcom,sm8550-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		orientation-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_dp_qmpphy_out>;
+					};
+				};
+
+				port@2 {
+					reg = <2>;
+
+					pmic_glink_sbu: endpoint {
+						remote-endpoint = <&wcd_usbss_sbu_mux>;
+					};
+				};
+			};
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&volume_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+
+		event-hall-sensor {
+			label = "Hall Effect Sensor";
+			gpios = <&tlmm 81 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	wcd939x: audio-codec {
+		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";
+
+		pinctrl-0 = <&wcd_default>;
+		pinctrl-names = "default";
+
+		qcom,micbias1-microvolt = <1800000>;
+		qcom,micbias2-microvolt = <1800000>;
+		qcom,micbias3-microvolt = <1800000>;
+		qcom,micbias4-microvolt = <1800000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		reset-gpios = <&tlmm 107 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&vreg_l15b_1p8>;
+		vdd-rxtx-supply = <&vreg_l15b_1p8>;
+		vdd-io-supply = <&vreg_l15b_1p8>;
+		vdd-mic-bias-supply = <&vreg_bob1>;
+
+		#sound-dai-cells = <1>;
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+	
+
+	sy7758_vdd: sy7758-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "sy7758_vdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+	reserved-memory {
+		aop_tme_uefi_merged_mem: aop-tme-uefi-merged@81c80000 { 
+			reg = <0x00 0x81c80000 0x00 0x75000 >;
+			no-map;
+		};
+			
+		lost_reg_mem: lost-reg-mem@9b09c000 {
+			no-map;
+			reg = <0x00 0x9b09c000 0x00 0x4000>;
+		};		
+		
+		linux,cma {
+			compatible = "shared-dma-pool";
+			size = <0x0 0x2000000>;
+			reusable;
+			linux,cma-default;
+		};
+		
+		ramoops@ac300000 {
+			compatible = "ramoops";
+			reg = <0x00 0xac300000 0x00 0x100000>;
+			record-size = <0x40000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x80000>;
+			/* ram_core.c 里 mem-type 的编号是
+			 *   0 = WCOMBINE, 1 = NONCACHED, 2 = NORMAL
+			 * 原来是 2(NORMAL/可缓存)：硬复位不会回写 cache，
+			 * 所以"面板一上电就硬锁"那几次 pstore 里什么都没有。
+			 * 改成 0(write-combining / Normal-NC) 让控制台日志直接
+			 * 落到 DRAM，复位后可在 /sys/fs/pstore 读回。
+			 * 不用 1(noncached)：arm64 上是 Device-nGnRnE，ramoops 的
+			 * 非对齐访问会触发 alignment fault。 */
+			mem-type = <0x00>;
+			ecc-size = <0x10>;
+		};		
+			/* TB710FU: bootloader splash framebuffer.  The kernel's boot
+		 * console, liveness gauge and initcall bar draw into it at a fixed
+		 * physical address (0xd5100000); see tb_mark()/tbfb in
+		 * init/main.c.  U-Boot adds this node itself, but writes its reg
+		 * byte-swapped (it lands as base 0x10d5 size 0x9001, reserving
+		 * nothing) and marks it no-map.  Declaring it here wins, because
+		 * U-Boot only fills in a node that is missing.
+		 *
+		 * Reserved, and deliberately NOT no-map: the drawing code reaches
+		 * it through __va(), which needs the region in the linear map.
+		 *
+		 * Without the reservation the page allocator hands these pages out
+		 * as page cache and the drawing code then overwrites whatever was
+		 * allocated there -- silent corruption of large files.
+		 */
+		framebuffer_mem: framebuffer@d5100000 {
+			reg = <0x00 0xd5100000 0x00 0x1900000>;
+		};
+
+		/* TB710FU: the two rings the boot log black box appends to
+		 * (tb_bb_pa[] in init/main.c).  Same rule: reserved, not no-map.
+		 */
+		blackbox_a_mem: tb-blackbox-a@b0000000 {
+			reg = <0x00 0xb0000000 0x00 0x100000>;
+		};
+
+		blackbox_b_mem: tb-blackbox-b@d6a00000 {
+			reg = <0x00 0xd6a00000 0x00 0x100000>;
+		};
+
+};
+
+	wcn7850-pmu {
+		compatible = "qcom,wcn7850-pmu";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en>, <&bt_default>;
+
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
+
+		vdd-supply = <&vreg_s4i_0p85>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		vddio1p2-supply = <&vreg_l3c_1p2>;
+		vddaon-supply = <&vreg_s2c_0p8>;
+		vdddig-supply = <&vreg_s3c_0p9>;
+		vddrfa1p2-supply = <&vreg_s1c_1p2>;
+		vddrfa1p8-supply = <&vreg_s6c_1p8>;
+
+		clocks = <&rpmhcc RPMH_RF_CLK1>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+};
+
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8550-rpmh-regulators";
+
+		vdd-bob1-supply = <&vph_pwr>;
+		vdd-bob2-supply = <&vph_pwr>;
