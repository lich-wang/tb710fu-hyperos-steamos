+static int tb_tdm_raw_param(struct q6apm_graph *graph,
+			    const struct audioreach_module *module,
+			    u32 param_id, int dlen)
+{
+	struct apm_module_param_data *pd;
+	u32 words[9];
+	u8 zeros[256] = {};
+	int size = ALIGN(APM_MODULE_PARAM_DATA_SIZE + dlen, 8);
+	struct gpr_pkt *pkt __free(kfree);
+	void *p;
+	int i;
+
+	if (dlen > sizeof(zeros))
+		dlen = sizeof(zeros);
+
+	if (tb_usep) {
+		words[0] = tb_p0; words[1] = tb_p1; words[2] = tb_p2;
+		words[3] = tb_p3; words[4] = tb_p4; words[5] = tb_p5;
+		words[6] = tb_p6; words[7] = tb_p7; words[8] = tb_p8;
+		for (i = 0; i < 9 && (i + 1) * 4 <= dlen; i++)
+			memcpy(zeros + i * 4, &words[i], 4);
+	}
+
+	pkt = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	pd = p;
+	pd->module_instance_id = module->instance_id;
+	pd->error_code = 0;
+	pd->param_id = param_id;
+	pd->param_size = dlen;
+	memcpy(p + APM_MODULE_PARAM_DATA_SIZE, zeros, dlen);
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
