+static int aw_dev_parse_skt_type_v_1_0_0_0(struct aw_device *aw_dev,
+		struct aw_cfg_hdr *prof_hdr)
+{
+	int i = 0;
+	int ret;
+	int scene_id = 0;
+	struct aw_prof_info *prof_info = &aw_dev->prof_info;
+	struct aw_cfg_dde_v_1_0_0_0 *cfg_dde =
