+						     SND_SOC_CLOCK_IN);
+			if (ret && ret != -ENOTSUPP) {
+				dev_err(rtd->dev, "%s: failed to set codec sysclk on %s: %d\n",
+					__func__, codec_dai->name, ret);
+				return ret;
+			}
+		}
+	}
+
+	return 0;
+}
