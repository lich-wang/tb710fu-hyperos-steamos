+/* Second SY7758 backlight chip ("salve" in the vendor DT).  It answers at
+ * 0x2e on this bus and drives the other half of the panel LED strings.
+ * The driver mirrors the master's brightness onto it, so it registers no
+ * backlight device of its own (silergy,follower). */
+&i2c2 {
+	status = "okay";
+
+	backlight_slave: sy7758@2e {
+		compatible = "silergy,sy7758";
+		reg = <0x2e>;
+		vdd-supply = <&sy7758_vdd>;
+		silergy,follower;
+	};
+};
+
+// Lcd bias and backlight
+&i2c6 {
+	status = "okay";
+	
+	// Power
+	aw37504: regulator@3e {
+		reg = <0x3e>;
+		compatible = "awinic,aw37503";
+		pinctrl-0 = <&panel_pwr_active>;
+		pinctrl-1 = <&panel_pwr_sleep>;
+		pinctrl-names = "default", "sleep";
+		status = "okay";
+
+		/* 社区参考用单个 awinic,aw37504 节点、由 reset-gpios 同时控制
+		 * ENP/ENN；本树只有主线 aw37503 双路输出驱动，所以拆成 outp(VPOS,
+		 * ENP=tlmm90) / outn(VNEG, ENN=tlmm91) 两路，由面板驱动的
+		 * avdd-supply/avee-supply 在 prepare 里按 VCC→bias 顺序使能。 */
+		aw37504_avdd: outp {
+			regulator-name = "panel-avdd";
+			regulator-min-microvolt = <5800000>;
+			regulator-max-microvolt = <5800000>;
+			enable-gpios = <&tlmm 90 GPIO_ACTIVE_HIGH>;
+		};
+
+		aw37504_avee: outn {
+			regulator-name = "panel-avee";
+			regulator-min-microvolt = <5800000>;
+			regulator-max-microvolt = <5800000>;
+			enable-gpios = <&tlmm 91 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+	// Backlight master (SY7758)
+	backlight: sy7758@2e {
+		compatible = "silergy,sy7758";
+		reg = <0x2e>;
+		vdd-supply = <&sy7758_vdd>;
+	};
+
+};
