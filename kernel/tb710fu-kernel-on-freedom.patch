+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb2, 0x91);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb3, 0x40);
+	/*
+	 * EXIT_SLEEP_MODE and SET_DISPLAY_ON take no parameter, and that is how
+	 * every other dual-DSI panel in this driver sends them.  The vendor's
+	 * byte stream encodes both as "short write with 1 parameter" (dtype
+	 * 0x15, len 2), which is what this used to replay literally - and the
+	 * panel then answered GET_POWER_MODE with 0x00, i.e. still asleep.
+	 * Send them in the parameterless form the spec defines.
+	 */
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x11);
+	msleep(120);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x29);
+	msleep(20);
+
+	return 0;
