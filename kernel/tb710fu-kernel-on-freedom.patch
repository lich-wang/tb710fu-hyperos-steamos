+	}
+
+	if (is_single_cali) {
+		len += snprintf(buf+len, PAGE_SIZE-len, "%d\n", aw_dev->cali_desc.cali_re);
+	} else {
+		ret = aw_cali_svc_get_devs_cali_re(aw_dev, cali_re, AW_DEV_CH_MAX);
+		if (ret <= 0) {
+			aw_dev_err(aw_dev->dev, "get re failed ");
