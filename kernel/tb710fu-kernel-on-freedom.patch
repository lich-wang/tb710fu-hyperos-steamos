+	 * TB710FU v39: the vendor's 0x91/0x92 writes are Novatek's
+	 * proprietary DSC decoder configuration, and the working reference
+	 * driver sends the standard DCS PPS (0x9E) in exactly this position
+	 * - after DSC enable (0x90 0x03), before 0x9d/0xb2/0xb3 - instead of
+	 * them.  v38 proved PPS at the *start* of the sequence alongside the
+	 * two proprietary writes does nothing; one decoder config, in the
+	 * reference's slot, is what the panel gets.
+	 */
+	{
+		struct drm_dsc_picture_parameter_set pps;
+		int i;
+
+		drm_dsc_pps_payload_pack(&pps, &pinfo->dsc);
+		for (i = 0; i < 2; i++) {
+			int ret = mipi_dsi_picture_parameter_set(pinfo->dsi[i], &pps);
+
+			if (ret < 0)
