# TB710FU: turn on pen scanning in the NT36532 firmware whenever the pen input device appears
# (/proc/support_pen -> touch FW command 0x7B 0x01; it is 0 after every driver probe).
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="NVTCapacitivePen", RUN+="/bin/sh -c 'echo 1 > /proc/support_pen'"
