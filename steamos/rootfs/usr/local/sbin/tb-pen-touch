#!/usr/bin/env python3
"""tb-pen-touch: Lenovo Tab Pen Plus on SteamOS (TB710FU).

The NT36532 reports the pen as a tablet device ("NVTCapacitivePen",
novatek,pen-support). gamescope opens it but does nothing with tablet-tool
events, so the pen is dead in Game Mode. This grabs the pen device and
replays it as a one-finger touchscreen through uinput: pen down = finger
down, so the pen works everywhere touch does (gamescope touch mode included).
Hover and pressure are dropped. Re-finds the pen if the driver is reloaded
(tb-touch-check)."""
import fcntl, os, re, select, struct, time

PEN_NAME = "NVTCapacitivePen"
EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
SYN_REPORT = 0
BTN_TOUCH = 0x14a
ABS_X, ABS_Y = 0, 1
ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x2f, 0x35, 0x36, 0x39
INPUT_PROP_DIRECT = 1
EVIOCGRAB = 0x40044590
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 0x40045564, 0x40045565, 0x40045567, 0x4004556e
UI_DEV_SETUP, UI_ABS_SETUP, UI_DEV_CREATE = 0x405c5503, 0x401c5504, 0x5501
EV = struct.Struct("qqHHi")


def eviocgabs(code):
    return 0x80184540 + code


def find_pen():
    try:
        text = open("/proc/bus/input/devices").read()
    except OSError:
        return None
    for block in text.split("\n\n"):
        if f'Name="{PEN_NAME}"' in block:
            m = re.search(r"\bevent(\d+)\b", block)
            if m:
                return f"/dev/input/event{m.group(1)}"
    return None


def absinfo(fd, code):
    buf = bytearray(24)
    fcntl.ioctl(fd, eviocgabs(code), buf)
    return struct.unpack("6i", buf)  # value min max fuzz flat res


def make_touch(xinfo, yinfo):
    u = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(u, UI_SET_EVBIT, EV_KEY)
    fcntl.ioctl(u, UI_SET_EVBIT, EV_ABS)
    fcntl.ioctl(u, UI_SET_KEYBIT, BTN_TOUCH)
    fcntl.ioctl(u, UI_SET_PROPBIT, INPUT_PROP_DIRECT)
    axes = {ABS_X: xinfo, ABS_Y: yinfo, ABS_MT_POSITION_X: xinfo, ABS_MT_POSITION_Y: yinfo,
            ABS_MT_SLOT: (0, 0, 0, 0, 0, 0), ABS_MT_TRACKING_ID: (0, 0, 65535, 0, 0, 0)}
    for code, (_, mn, mx, _, _, res) in axes.items():
        fcntl.ioctl(u, UI_SET_ABSBIT, code)
        fcntl.ioctl(u, UI_ABS_SETUP, struct.pack("HH6i", code, 0, 0, mn, mx, 0, 0, res))
    name = b"TB710FU Pen (touch)"
    fcntl.ioctl(u, UI_DEV_SETUP, struct.pack("HHHH80sI", 0x06, 0x17ef, 0x617f, 1, name, 0))
    fcntl.ioctl(u, UI_DEV_CREATE)
    return u


def emit(u, events):
    os.write(u, b"".join(EV.pack(0, 0, t, c, v) for t, c, v in events) + EV.pack(0, 0, EV_SYN, SYN_REPORT, 0))


def pen_mode_on():
    # /proc/support_pen -> nvt_support_pen_set() -> touch FW cmd 0x7B 0x01 (pen scanning on);
    # it is 0 after every probe. Pen events were seen with it on (10/21).
    try:
        with open("/proc/support_pen", "w") as fh:
            fh.write("1")
    except OSError as exc:
        print(f"tb-pen-touch: support_pen: {exc}", flush=True)


def run(path):
    pen_mode_on()
    fd = os.open(path, os.O_RDONLY)
    xinfo, yinfo = absinfo(fd, ABS_X), absinfo(fd, ABS_Y)
    fcntl.ioctl(fd, EVIOCGRAB, 1)
    u = make_touch(xinfo, yinfo)
    print(f"tb-pen-touch: {path} -> uinput touch ({xinfo[2]}x{yinfo[2]})", flush=True)
    x, y, down, was_down, tid = 0, 0, False, False, 0
    try:
        while True:
            data = os.read(fd, EV.size * 64)
            for i in range(0, len(data) - EV.size + 1, EV.size):
                _, _, t, c, v = EV.unpack_from(data, i)
                if t == EV_ABS and c == ABS_X:
                    x = v
                elif t == EV_ABS and c == ABS_Y:
                    y = v
                elif t == EV_KEY and c == BTN_TOUCH:
                    down = bool(v)
                elif t == EV_SYN and c == SYN_REPORT:
                    if down and not was_down:
                        tid = (tid + 1) & 0xffff
                        emit(u, [(EV_ABS, ABS_MT_SLOT, 0), (EV_ABS, ABS_MT_TRACKING_ID, tid),
                                 (EV_ABS, ABS_MT_POSITION_X, x), (EV_ABS, ABS_MT_POSITION_Y, y),
                                 (EV_KEY, BTN_TOUCH, 1), (EV_ABS, ABS_X, x), (EV_ABS, ABS_Y, y)])
                    elif down:
                        emit(u, [(EV_ABS, ABS_MT_SLOT, 0), (EV_ABS, ABS_MT_POSITION_X, x),
                                 (EV_ABS, ABS_MT_POSITION_Y, y), (EV_ABS, ABS_X, x), (EV_ABS, ABS_Y, y)])
                    elif was_down:
                        emit(u, [(EV_ABS, ABS_MT_SLOT, 0), (EV_ABS, ABS_MT_TRACKING_ID, -1),
                                 (EV_KEY, BTN_TOUCH, 0)])
                    was_down = down
    finally:
        os.close(u)
        os.close(fd)


def main():
    while True:
        path = find_pen()
        if path:
            try:
                run(path)
            except OSError as exc:  # pen device went away (driver reload)
                print(f"tb-pen-touch: {path}: {exc}", flush=True)
        time.sleep(2)


if __name__ == "__main__":
    main()
