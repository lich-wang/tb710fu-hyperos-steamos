+#define EARLY_DEVICE_LIMIT UINT64_C(0x1000000000)
+int kshim_mmu_early_enable(uint64_t fdt, uint64_t fdt_size)
+{
+    uint64_t lo[2], hi[2], cursor = 0;
+    kshim_mmu_region_t wb[2];
+    if (mMmu.configured || kshim_mmu_is_enabled() || !fdt || !fdt_size ||
+        fdt > UINT64_MAX - fdt_size)
+        return -1;
+    uint64_t ib = align_down((uint64_t)(uintptr_t)__image_start_address__, MMU_PAGE_SIZE);
+    uint64_t ie, fb = align_down(fdt, MMU_PAGE_SIZE), fe;
+    if (align_up((uint64_t)(uintptr_t)__image_end_address__, MMU_PAGE_SIZE, &ie) ||
+        align_up(fdt + fdt_size, MMU_PAGE_SIZE, &fe) || ie > EARLY_DEVICE_LIMIT ||
+        fe > EARLY_DEVICE_LIMIT || (fb < ie && ib < fe))
+        return -1;
+    wb[0] = (kshim_mmu_region_t){ib, ie - ib, KSHIM_MMU_NORMAL_WB,
+        KSHIM_MMU_READ | KSHIM_MMU_WRITE | KSHIM_MMU_EXECUTE};
+    wb[1] = (kshim_mmu_region_t){fb, fe - fb, KSHIM_MMU_NORMAL_WB,
+        KSHIM_MMU_READ | KSHIM_MMU_WRITE};
+    if (fb < ib) { kshim_mmu_region_t t = wb[0]; wb[0] = wb[1]; wb[1] = t; }
+    for (unsigned i = 0; i < 2; ++i) { lo[i] = wb[i].base; hi[i] = wb[i].base + wb[i].size; }
+
+    memset(&mMmu, 0, sizeof(mMmu));
+    memset(mTables, 0, sizeof(mTables));
+    mMmu.root = allocate_table();
+    if (mMmu.root == NULL)
+        return -2;
+    for (unsigned i = 0; i < 2; ++i) {
+        if (lo[i] > cursor) {
+            kshim_mmu_region_t dev = {cursor, lo[i] - cursor, KSHIM_MMU_DEVICE,
+                                      KSHIM_MMU_READ | KSHIM_MMU_WRITE};
+            if (add_region(&dev)) goto fail;
+        }
+        if (add_region(&wb[i])) goto fail;
+        cursor = hi[i];
+    }
+    if (cursor < EARLY_DEVICE_LIMIT) {
+        kshim_mmu_region_t dev = {cursor, EARLY_DEVICE_LIMIT - cursor, KSHIM_MMU_DEVICE,
+                                  KSHIM_MMU_READ | KSHIM_MMU_WRITE};
+        if (add_region(&dev)) goto fail;
+    }
+    mMmu.entry_el = current_el();
+    mMmu.configured = 1U;
+#if defined(__aarch64__)
+    clean_range((uint64_t)(uintptr_t)&mMmu, sizeof(mMmu));
+    clean_range((uint64_t)(uintptr_t)mTables, sizeof(mTables));
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+    if (enable_at_el(mMmu.entry_el)) goto fail;
     return 0;
+fail:
+    memset(&mMmu, 0, sizeof(mMmu));
+    return -3;
 }
 
+int kshim_mmu_early_disable(void)
+{
+    if (!mMmu.configured)
+        return 0;
+    uint64_t ib = (uint64_t)(uintptr_t)__image_start_address__;
+    uint64_t ie = (uint64_t)(uintptr_t)__image_end_address__;
+    kshim_mmu_region_t keep[2];
+    size_t n = 0;
+    for (size_t i = 0; i < mMmu.region_count && n < 2; ++i)
+        if (mMmu.regions[i].type == KSHIM_MMU_NORMAL_WB) keep[n++] = mMmu.regions[i];
+    (void)kshim_mmu_prepare_handoff();
+    /* Lines allocated between the clean above and SCTLR.M/C=0 (stack, this
+     * frame) are written back and dropped here, with caches already off. */
+    for (size_t i = 0; i < n; ++i) clean_range(keep[i].base, keep[i].size);
+    clean_range(ib, ie - ib);
+#if defined(__aarch64__)
+    __asm__ volatile("dsb sy\nic iallu\ndsb sy\nisb" ::: "memory");
+#endif
+    memset(&mMmu, 0, sizeof(mMmu));
+    return 0;
+}
