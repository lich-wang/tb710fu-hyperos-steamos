+#define TB710FU_DUMP_WORDS 64
+static uint32_t g_tb710fu_dump[TB710FU_DUMP_WORDS];
+static unsigned g_tb710fu_dump_count;
+static void tb710fu_dump_capture(uint64_t base, uint64_t size, const struct CrIo *io,
+                                 const uint32_t *ctl, int ctls, const uint32_t *mixer,
+                                 int mixers, const uint32_t *pipe, int pipes)
+{
+    static const uint16_t ctl0_regs[10] = {0xf4, 0x14, 0x00, 0x04, 0x08, 0x0c,
+                                           0x40, 0x44, 0x48, 0x4c};
+    static const uint16_t vig_regs[6] = {0x00, 0x08, 0x14, 0x24, 0x30, 0x34};
+    uint64_t offs[TB710FU_DUMP_WORDS];
+    unsigned n = 0;
+    g_tb710fu_dump_count = 0;
+    if (!io || !io->read32 || ctls < 1 || mixers < 4 || pipes < 6) return;
+    for (unsigned i = 0; i < 10; ++i) offs[n++] = (uint64_t)ctl[0] + ctl0_regs[i];
+    for (unsigned m = 0; m < 4; ++m) { offs[n++] = mixer[m]; offs[n++] = (uint64_t)mixer[m] + 4; }
+    for (unsigned p = 0; p < 4; ++p)
+        for (unsigned k = 0; k < 6; ++k) offs[n++] = (uint64_t)pipe[p] + vig_regs[k];
+    for (unsigned p = 4; p < 6; ++p) { offs[n++] = pipe[p]; offs[n++] = (uint64_t)pipe[p] + 0x14; }
+    for (unsigned i = 0; i < n; ++i)
+        if ((offs[i] & 3) || offs[i] + 4 > size) return;
+    for (unsigned i = 0; i < n; ++i)
+        g_tb710fu_dump[i] = io->read32(io->context, (uintptr_t)(base + offs[i]));
+    g_tb710fu_dump_count = n;
+}
