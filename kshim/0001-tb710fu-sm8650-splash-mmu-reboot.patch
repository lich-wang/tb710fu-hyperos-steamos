+    return snprintf(out, capacity, "r31:s=%d:a=%llx:w=%u:h=%u:st=%u:f=%u:sz=%llx",
+                    g_tb710fu_fb_status, (unsigned long long)g_tb710fu_fb.address,
+                    (unsigned)g_tb710fu_fb.width, (unsigned)g_tb710fu_fb.height,
+                    (unsigned)g_tb710fu_fb.stride, (unsigned)g_tb710fu_fb.format,
+                    (unsigned long long)g_tb710fu_fb.size);
+}
+int kshim_tb710fu_dump_report(unsigned slot, char *out, size_t capacity)
+{
+    if (!out || capacity < 81 || slot > 7 || !g_tb710fu_dump_count) return -1;
+    int n = snprintf(out, capacity, "r30:%u:", slot);
+    if (n != 6) return -1;
+    for (unsigned i = 0; i < 8; ++i) {
+        unsigned idx = slot * 8u + i;
+        uint32_t w = idx < g_tb710fu_dump_count ? g_tb710fu_dump[idx] : 0xdeadbeefu;
+        int m = snprintf(out + n, capacity - (size_t)n, "%08x", (unsigned)w);
+        if (m != 8) return -1;
+        n += m;
+    }
+    return n;
+}
